# RoyalMedico Auth Service - Local Development Environment Configuration
# Copy this file to your local development environment or export these variables in your shell.
# DO NOT commit real secrets or passwords to version control.

# Required: PostgreSQL password for local database
DB_PASSWORD=your_local_postgres_password

# Optional: Override local PostgreSQL URL or username if different from defaults
# DB_URL=jdbc:postgresql://localhost:5432/auth_user
# DB_USERNAME=postgres

# Required: 256-bit Base64-encoded JWT signing secret (synchronized with api-gateway)
JWT_BASE64_SECRET=REPLACE_WITH_YOUR_OWN_BASE64_SECRET

